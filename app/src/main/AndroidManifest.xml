<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GitHub から .yosuga/status.json を取得するために必要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 端末に同期済みのカレンダー(Googleカレンダー含む)を読むために必要。読み取り専用 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!--
        朝の準備で ChatGPT アプリを名指しして現況を渡すために必要(2026-07-26)。
        Android 11 以降はパッケージが既定で「見えない」ので、setPackage した
        startActivity が ActivityNotFoundException になる。ここで宣言した相手だけ見える。
        ※ 選択画面(createChooser)は宣言なしでも動く。名指しのときだけ要る。
    -->
    <queries>
        <package android:name="com.openai.chatgpt" />
    </queries>

    <application
        android:name=".YosugaHubApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YosugaHub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.YosugaHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                ChatGPT 等から「共有 → Yosuga Hub」でレコルの回答を受け取る。
                貼り付けの代わりの入口(クリップボード監視は Android 12+ で
                毎回システムのトーストが出るため採らない)。
                singleTop にしているのは、起動済みのときに新しい画面を積まず
                onNewIntent で受けるため。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
